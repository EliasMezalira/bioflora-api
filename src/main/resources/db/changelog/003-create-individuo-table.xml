<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="003-create-individuo-table" author="bioflora">
        <createTable tableName="tb_individuo">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="parcela" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="nome_popular" type="VARCHAR(100)"/>
            <column name="nome_cientifico" type="VARCHAR(200)"/>
            <column name="diametro_caule" type="DOUBLE PRECISION"/>
            <column name="vivo_morto" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="data_levantamento" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="levantamento_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_individuo_levantamento" references="tb_levantamento(id)" deleteCascade="true"/>
            </column>
        </createTable>
        <createIndex tableName="tb_individuo" indexName="idx_individuo_levantamento_id">
            <column name="levantamento_id"/>
        </createIndex>
        <createIndex tableName="tb_individuo" indexName="idx_individuo_data_levantamento">
            <column name="data_levantamento"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>