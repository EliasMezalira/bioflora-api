<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="002-create-levantamento-table" author="bioflora">
        <createTable tableName="tb_levantamento">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="bioma" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(500)"/>
            <column name="cidade" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="pais" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="data_criacao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="data_atualizacao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_levantamento_usuario" references="tb_usuario(id)" deleteCascade="true"/>
            </column>
        </createTable>
        <createIndex tableName="tb_levantamento" indexName="idx_levantamento_usuario_id">
            <column name="usuario_id"/>
        </createIndex>
        <createIndex tableName="tb_levantamento" indexName="idx_levantamento_data_criacao">
            <column name="data_criacao"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>